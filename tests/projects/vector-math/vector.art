; Official-function focus: module, method.public, export, function,
; couple, map, fold, hypot, throw, standalone?.
;
; Pattern from official `module` docs + agent-shell.art file import:
;   - helpers live in the module as function
;   - sibling calls use \name
;   - only method.public is exported
;   - do not name a public method add/sub; that shadows arithmetic
;
; Vectors are blocks of :integer / :floating. Do not write [-1 2]:
; that block contains the symbol `-`. Use @[neg 1 2].

vector: module [
    numericValue?: function [x][
        or? integer? x floating? x
    ]

    ensurePair: function [left :block right :block][
        unless (size left) = size right [
            throw "vector size mismatch"
        ]
        unless every? left 'x [\numericValue? x] [
            throw "left vector is not numeric"
        ]
        unless every? right 'x [\numericValue? x] [
            throw "right vector is not numeric"
        ]
    ]

    ensureOne: function [v :block][
        unless every? v 'x [\numericValue? x] [
            throw "vector is not numeric"
        ]
    ]

    pairAdd: function [pair][
        (get pair 0) + get pair 1
    ]

    pairSub: function [pair][
        (get pair 0) - get pair 1
    ]

    pairMul: function [pair][
        (get pair 0) * get pair 1
    ]

    almostEqual?: function [x y][
        0.0000001 > abs (x - y)
    ]

    vecAdd: method.public [left :block right :block][
        \ensurePair left right
        map couple left right 'p [
            \pairAdd p
        ]
    ]

    vecSub: method.public [left :block right :block][
        \ensurePair left right
        map couple left right 'p [
            \pairSub p
        ]
    ]

    vecScale: method.public [v :block k][
        \ensureOne v
        unless \numericValue? k [
            throw "scale factor is not numeric"
        ]
        map v 'x [x * k]
    ]

    vecNeg: method.public [v :block][
        \vecScale v neg 1
    ]

    vecDot: method.public [left :block right :block][
        \ensurePair left right
        fold.seed:0 couple left right [acc p][
            acc + \pairMul p
        ]
    ]

    vecMag: method.public [v :block][
        \ensureOne v
        (2 = size v)? [
            hypot get v 0 get v 1
        ] [
            sqrt \vecDot v v
        ]
    ]

    vecNormalize: method.public [v :block][
        mag: \vecMag v
        (0 = mag)? [
            throw "cannot normalize a zero vector"
        ] [
            map v 'x [x // mag]
        ]
    ]

    vecCross: method.public [left :block right :block][
        unless and? (3 = size left) (3 = size right) [
            throw "cross product needs two 3D vectors"
        ]
        \ensurePair left right
        ax: get left 0
        ay: get left 1
        az: get left 2
        bx: get right 0
        by: get right 1
        bz: get right 2
        @[
            (ay * bz) - (az * by)
            (az * bx) - (ax * bz)
            (ax * by) - (ay * bx)
        ]
    ]

    vecDistance: method.public [left :block right :block][
        \vecMag \vecSub left right
    ]

    vecAlmostEqual?: method.public [left :block right :block][
        and? ((size left) = size right)
             every? couple left right 'p [
                \almostEqual? get p 0 get p 1
             ]
    ]
]

export vector!

if standalone? [
    ensure.that: "module value stays bound" [(type vector) = :module]
    ensure.that: "public method is exported" [set? 'vecAdd]
    ensure.that: "private function is not exported" [not? set? 'ensurePair]
    ensure.that: "private pairAdd is not exported" [not? set? 'pairAdd]
    ensure.that: "exporting vecAdd does not shadow +" [3 = 1 + 2]

    ensure.that: "add pairs by couple order" [[5 7 9] = vecAdd [1 2 3] [4 5 6]]
    ensure.that: "sub is element-wise" [@[neg 3 neg 3 neg 3] = vecSub [1 2 3] [4 5 6]]
    ensure.that: "scale multiplies components" [[2 4 6] = vecScale [1 2 3] 2]
    ensure.that: "neg flips sign" [@[neg 1 neg 2 neg 3] = vecNeg [1 2 3]]
    ensure.that: "dot of 123 and 456" [32 = vecDot [1 2 3] [4 5 6]]
    ensure.that: "2D magnitude uses hypot" [5.0 = vecMag [3 4]]
    ensure.that: "3D magnitude uses sqrt of norm2" [3.0 = vecMag [1 2 2]]
    ensure.that: "normalize 3-4" [vecAlmostEqual? [0.6 0.8] vecNormalize [3 4]]
    ensure.that: "i cross j is k" [[0 0 1] = vecCross [1 0 0] [0 1 0]]
    ensure.that: "cross 123 x 456" [@[neg 3 6 neg 3] = vecCross [1 2 3] [4 5 6]]
    ensure.that: "distance of 3-4-5" [5.0 = vecDistance [0 0] [3 4]]
    ensure.that: "negative components via evaluated block" [
        [0 0] = vecAdd @[neg 1 2] @[1 neg 2]
    ]
    ensure.that: "size mismatch throws" [throws? [vecAdd [1 2] [1]]]
    ensure.that: "zero vector cannot normalize" [throws? [vecNormalize [0 0]]]
    ensure.that: "2D cross throws" [throws? [vecCross [1 2] [3 4]]]
    ensure.that: "non-numeric vector throws" [throws? [vecAdd ["a" 1] [2 3]]]

    print "PASS projects/vector-math/lib"
]
