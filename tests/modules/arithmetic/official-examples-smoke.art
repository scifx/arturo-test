; --- add example 1 ---
print add 1 2      ; 3
print 1 + 3        ; 4

; --- add example 2 ---
a: 4
add 'a 1           ; a: 5

; --- add example 3 ---
; adding a time quantity to a date gives us a new date
print (to :date "2021-03-22T11:25:30+01:00") + 3`days
; 2021-03-25T11:25:30+01:00

; --- dec example 1 ---
print dec 5        ; 4

; --- dec example 2 ---
a: 4
dec 'a             ; a: 3

; --- div example 1 ---
print div 5 2      ; 2
print 9 / 3        ; 3

; --- div example 2 ---
a: 6
div 'a 3           ; a: 2

; --- divmod example 1 ---
print divmod 15 5       ; 3 0
print 14 /% 3           ; 4 2

; --- divmod example 2 ---
[q,r]: 10 /% 3          ; q: 3, r: 1

; --- divmod example 3 ---
a: 6
divmod 'a 4             ; a: [1, 2]

; --- fdiv example 1 ---
print fdiv 5 2     ; 2.5
print 5 // 2       ; 2.5

; --- fdiv example 2 ---
a: 6
fdiv 'a 3          ; a: 2.0

; --- inc example 1 ---
print inc 5        ; 6

; --- inc example 2 ---
a: 4
inc 'a             ; a: 5

; --- mod example 1 ---
print mod 5 2      ; 1
print 9 % 3        ; 0

; --- mod example 2 ---
a: 8
mod 'a 3           ; a: 2

; --- mul example 1 ---
print mul 1 2      ; 2
print 2 * 3        ; 6

; --- mul example 2 ---
a: 5
mul 'a 2           ; a: 10

; --- neg example 1 ---
print neg 1        ; -1

; --- neg example 2 ---
a: 5
neg 'a             ; a: -5

; --- pow example 1 ---
print pow 2 3      ; 8
