; --- sub example 1 ---
print sub 2 1      ; 1
print 5 - 3        ; 2

; --- sub example 2 ---
a: 7
sub 'a 2           ; a: 5

; --- sub example 3 ---
; subtracting two dates gives us the elapsed time, as a quantity
d1: to :date "1995-02-03T12:00:00+08:00"
d2: to :date "2025-06-09T12:00:00+08:00"
print (d2 - d1) --> `day
; 11084.0`day

