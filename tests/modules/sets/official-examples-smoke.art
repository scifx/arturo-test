; Generated raw official examples smoke for module: sets
; Source: info.get 'symbol | get 'example from the prepared upstream skill/runtime.
; This file intentionally runs only modules whose full raw examples passed locally.

; --- difference example 1 ---
print difference [1 2 3 4] [3 4 5 6]
; 1 2

; --- difference example 2 ---
a: [1 2 3 4]
b: [3 4 5 6]
difference 'a b
; a: [1 2]

; --- difference example 3 ---
print difference.symmetric [1 2 3 4] [3 4 5 6]
; 1 2 5 6

; --- disjoint? example 1 ---
disjoint? [1 2 3 4] [3 4 5 6]
; => false

disjoint? [1 2 3 4] [5 6 7 8]
; => true

; --- intersect? example 1 ---
intersect? @1..10 @8..12
; => true

intersect? ["one" "two" "three"] ["three" "four" "five"]
; => true

intersect? ["one" "two" "three"] ["four" "five" "six"]
; => false

; --- intersection example 1 ---
print intersection [1 2 3 4] [3 4 5 6]
; 3 4

; --- intersection example 2 ---
a: [1 2 3 4]
b: [3 4 5 6]
intersection 'a b
; a: [3 4]

; --- powerset example 1 ---
powerset [1 2 3]
;  [[] [1] [2] [1 3] [3] [1 2] [2 3] [1 2 3]]

; --- subset? example 1 ---
subset? [1 3] [1 2 3 4]
; => true

subset?.proper [1 3] [1 2 3 4]
; => true

subset? [1 3] [3 5 6]
; => false

subset? [1 3] [1 3]
; => true

subset?.proper [1 3] [1 3]
; => false

; --- superset? example 1 ---
superset? [1 2 3 4] [1 3]
; => true

superset?.proper [1 2 3 4] [1 3]
; => true

superset? [3 5 6] [1 3]
; => false

superset? [1 3] [1 3]
; => true

superset?.proper [1 3] [1 3]
; => false

; --- union example 1 ---
print union [1 2 3 4] [3 4 5 6]
; 1 2 3 4 5 6

; --- union example 2 ---
a: [1 2 3 4]
b: [3 4 5 6]
union 'a b
; a: [1 2 3 4 5 6]

