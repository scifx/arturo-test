; --- between? example 1 ---
between? 1 2 3      ; => false
between? 2 0 3      ; => true
between? 3 2 3      ; => true
between? 3 3 2      ; => true

1 <=> 2 3           ; => false
1 <=> 3 2           ; => false
2 <=> 0 3           ; => true
2 <=> 3 0           ; => true
3 <=> 2 3           ; => true

; --- compare example 1 ---
compare 1 2           ; => -1
compare 3 3           ; => 0
compare 4 3           ; => 1

; --- equal? example 1 ---
equal? 5 2            ; => false
equal? 5 6-1          ; => true

print 3=3             ; true

; --- greater? example 1 ---
greater? 5 2          ; => true
greater? 5 6-1        ; => false

print 3>2             ; true

; --- greaterOrEqual? example 1 ---
greaterOrEqual? 5 2   ; => true
greaterOrEqual? 5 4-1 ; => false

print 2>=2            ; true

; --- less? example 1 ---
less? 5 2             ; => false
less? 5 6+1           ; => true

print 2<3             ; true

; --- lessOrEqual? example 1 ---
lessOrEqual? 5 2      ; => false
lessOrEqual? 5 6-1    ; => true

print 2=<3            ; true

; --- notEqual? example 1 ---
notEqual? 5 2         ; => true
notEqual? 5 6-1       ; => false

print 2<>3            ; true

; --- same? example 1 ---
same? 1 2           ; => false
same? 3 3           ; => true
same? 3 3.0         ; => false

