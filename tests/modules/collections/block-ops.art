; Module area: Collections / blocks
; Source: official collections chapter + info.get examples, verified on runtime.
; Focus: mutation vs copy, couple order, chop/drop/take/pop, split/slice,
; sort, squeeze, rotate, flatten, range indexing.

a: [1 2 3]
b: a
c: new a
'b ++ 9
ensure.that: "assignment aliases the same block" [[1 2 3 9] = a]
ensure.that: "new is an independent copy" [[1 2 3] = c]

ensure.that: "couple keeps first collection first" [
    [["one" 1] ["two" 2]] = couple ["one" "two"] [1 2]
]
paired: couple [1 2] [10 20]
ensure.that: "couple [1 2] [10 20]" [[[1 10] [2 20]] = paired]
parts: decouple paired
ensure.that: "decouple first row" [[1 2] = get parts 0]
ensure.that: "decouple second row" [[10 20] = get parts 1]

ensure.that: "append value" [[1 2 3 4] = append [1 2 3] 4]
ensure.that: "append block flattens one level" [[1 2 3 4 5] = append [1 2 3] [4 5]]
ensure.that: "++ same as append" [[1 2 3 4] = [1 2 3] ++ 4]
ensure.that: "prepend" [[1 2 3] = prepend [2 3] 1]

ensure.that: "chop last" [[1 2] = chop [1 2 3]]
ensure.that: "chop.times:2" [[1] = chop.times: 2 [1 2 3]]
ensure.that: "chop.times neg 1 drops from front" [[2 3] = chop.times: (neg 1) [1 2 3]]
ensure.that: "drop first" [[2 3] = drop [1 2 3]]
ensure.that: "drop.times:2" [[3] = drop.times: 2 [1 2 3]]
ensure.that: "drop.times neg 1 drops from end" [[1 2] = drop.times: (neg 1) [1 2 3]]
ensure.that: "take 2" [[1 2] = take [1 2 3 4] 2]
ensure.that: "take neg 2 from end" [[3 4] = take [1 2 3 4] (neg 2)]
ensure.that: "take past end keeps all" [[1 2 3] = take [1 2 3] 4]

p: [0 1 2 3]
q: pop 'p
ensure.that: "pop last value" [3 = q]
ensure.that: "pop mutates" [[0 1 2] = p]
r: pop.n: 2 'p
ensure.that: "pop.n:2 returns a block" [[1 2] = r]
ensure.that: "pop.n:2 left the prefix" [[0] = p]

ensure.that: "insert at 0" [["z" 1 2 3] = insert [1 2 3] 0 "z"]
ensure.that: "remove value" [[1 2 3] = remove [1 2 3 4] 4]
ensure.that: "remove.once one l" ["helo" = remove.once "hello" "l"]
ensure.that: "flatten.once keeps inner" [
    [1 2 3 4 [5 6]] = flatten.once [1 [2 3] [4 [5 6]]]
]
ensure.that: "flatten all the way" [
    [1 2 3 4 5 6] = flatten [1 [2 3] [4 [5 6]]]
]

ensure.that: "slice string 0 3 is Hell" ["Hell" = slice "Hello" 0 3]
ensure.that: "slice of a range needs @" [[4 5] = slice (@1..10) 3 4]
ensure.that: "bare range slice throws" [throws? [slice 1..10 3 4]]

ensure.that: "split.words" [["hello" "world"] = split.words "hello world"]
ensure.that: "split.by comma" [["hello" "world"] = split.by: "," "hello,world"]
ensure.that: "split.at:4" [["hell" "oworld"] = split.at: 4 "helloworld"]
ensure.that: "split.every:2" [
    ["he" "ll" "ow" "or" "ld"] = split.every: 2 "helloworld"
]
ensure.that: "split chars are strings" ["h" = get (split "hi") 0]

ensure.that: "sort copy" [[1 3 6] = sort [3 1 6]]
ensure.that: "sort.descending" [[6 3 1] = sort.descending [3 1 6]]
ensure.that: "squeeze runs" [[1 2 3 4 2] = squeeze [1 1 2 3 4 2]]
ensure.that: "rotate right 1" [
    ["e" "a" "b" "c" "d"] = rotate ["a" "b" "c" "d" "e"] 1
]
ensure.that: "rotate.left 1" [
    ["b" "c" "d" "e" "a"] = rotate.left ["a" "b" "c" "d" "e"] 1
]
ensure.that: "repeat block" [[1 2 1 2 1 2] = repeat [1 2] 3]
ensure.that: "repeat scalar" [[5 5 5] = repeat 5 3]
ensure.that: "max" [8 = max [4 2 8 1]]
ensure.that: "min" [1 = min [4 2 8 1]]
ensure.that: "sorted?" [sorted? [1 2 3]]
ensure.that: "sorted?.descending" [sorted?.descending [3 2 1]]
ensure.that: "one? single block" [one? ["apple"]]
ensure.that: "zero? empty block" [zero? []]
ensure.that: "first.n:2" [["one" "two"] = first.n: 2 ["one" "two" "three"]]
ensure.that: "last.n:2" [["two" "three"] = last.n: 2 ["one" "two" "three"]]
ensure.that: "in? value collection" [in? 2 [1 2 3]]
ensure.that: "contains? collection value" [contains? [1 2 3] 2]
ensure.that: "in? on a range" [in? 5 0..10]
ensure.that: "index missing is null" [null? index "hello" "x"]
ensure.that: "index of e in hello" [1 = index "hello" "e"]

emptied: [1 2]
empty 'emptied
ensure.that: "empty mutates to []" [[] = emptied]

print "PASS collections/block-ops"
