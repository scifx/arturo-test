; Module area: Bitwise
; Source: https://arturo-lang.io/documentation/library/bitwise
; Official-function focus: and or xor not nand nor xnor shl shr

x: 5
y: 3
ensure.that: "and 5 3 is 1" [1 = and x y]
ensure.that: "or 5 3 is 7" [7 = or x y]
ensure.that: "xor 5 3 is 6" [6 = xor x y]
ensure.that: "not 5 is two's complement -6" [(neg 6) = not x]

a: 12
b: 9
ensure.that: "nand 12 9" [(neg 9) = nand a b]
ensure.that: "nor 12 9" [(neg 14) = nor a b]
ensure.that: "xnor 12 9" [(neg 6) = xnor a b]

num: 8
ensure.that: "shl 8 2 is *4" [32 = shl num 2]
ensure.that: "shr 8 1 is /2" [4 = shr num 1]
ensure.that: "bit 3 of 42 is set" [8 = and 42 (shl 1 3)]

number: 10
pos: 2
number: or number (shl 1 pos)
ensure.that: "set bit 2 of 10 via chapter pattern" [14 = number]
number: and number (not shl 1 pos)
ensure.that: "clear bit 2 via chapter pattern" [10 = number]

ensure.that: "bitwise and is not logic and?" [1 = and 5 3]
ensure.that: "logic and? of integers is not this module" [true = and? true true]

print "PASS bitwise/chapter-overview"
